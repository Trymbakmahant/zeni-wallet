{
  "name": "@zeni/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared cryptographic and RPC engine for Zeni Wallet",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./explorer": {
      "types": "./dist/rpc/explorer.d.ts",
      "import": "./dist/rpc/explorer.js",
      "default": "./dist/rpc/explorer.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "@qorechain/sdk": "^0.14.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^1.4.0",
    "@scure/bip39": "^1.3.0",
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5"
  }
}
